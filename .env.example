APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Source database for the nightly db:sync-staging command (staging -> live).
# STAGING_DB_HOST=127.0.0.1
# STAGING_DB_PORT=3306
# STAGING_DB_DATABASE=n0c2265_staging
# STAGING_DB_USERNAME=n0c2265_staging
# STAGING_DB_PASSWORD=
# Optional overrides if the CLI tools are not on PATH (cPanel cron often needs full paths).
# MYSQLDUMP_PATH=/usr/bin/mysqldump
# MYSQL_PATH=/usr/bin/mysql
# Optional: email when the nightly db:sync-staging job fails.
# SCHEDULE_FAILURE_EMAIL=you@example.com

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Accommodation Workforce module: scheduling app + login handoff.
# Shared secret must match LODGEX_INTEGRATION_KEY on the camp-reservations app.
LODGEX_INTEGRATION_KEY=

# LodgeX AI foundation (default shadow — proposals only, no auto-execution).
# Never commit a real key. Tests force AI_PROVIDER=mock (no network).
AI_ENABLED=true
AI_MODE=shadow
AI_PROVIDER=xai
AI_DEFAULT_MODEL=grok-4.6
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# AI_ROOM_INVENTORY_AGENT=true
# AI_ROOM_INVENTORY_MODE=
# AI_HOUSEKEEPING_WORKLOAD_AGENT=true
# AI_HOUSEKEEPING_WORKLOAD_MODE=
# AI_LABOUR_FORECAST_AGENT=true
# AI_LABOUR_FORECAST_MODE=
# AI_LODGE_MANAGER_EMAILS=
# AI_LODGE_MANAGER_USER_IDS=
# Optional override; defaults to http://camp.site locally, prod reservations1 otherwise.
# ACCOMMODATION_WORKFORCE_SCHEDULING_BASE=https://reservations1.lodgex.ca

# LangSmith tracing (optional). Missing key = skip. Never required at runtime.
# Projects: lodgex-room-inventory-intelligence, lodgex-housekeeping-workload, lodgex-labour-forecast
# LANGSMITH_API_KEY=
# LANGCHAIN_API_KEY=
# LANGSMITH_PROJECT=lodgex-room-inventory-intelligence
# LANGCHAIN_PROJECT=lodgex-room-inventory-intelligence
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_TRACING=true
# LANGCHAIN_TRACING_V2=true

# Cloudflare lodgex-mcp Worker → Laravel read-only API.
# Worker also needs LODGEX_API_BASE (set on the Worker, not in this file).
# LODGEX_MCP_TOKEN=
